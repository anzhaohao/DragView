{
  "name": "dsh-dragview",
  "version": "0.1.0",
  "description": "DragView：为 DeepSeek Harness 提供拖拽文件、Codex 风格附件卡片、安全文件预览与系统打开能力",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "drag",
    "drag-and-drop",
    "drag-file",
    "file-drag",
    "file-preview",
    "pdf-preview",
    "video-preview",
    "audio-preview",
    "file-path",
    "attachment",
    "file-attachment",
    "codex-style",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anzhaohao/DragView.git"
  },
  "homepage": "https://github.com/anzhaohao/DragView#readme",
  "bugs": {
    "url": "https://github.com/anzhaohao/DragView/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/client.js && node --check src/index.js && node --check src/file-access.js && node --check src/side-chat-bridge.js && node --check src/fingerprint.js && node --check src/client-fingerprint.js && node --check src/client-export-bridge.js && node --check src/client/rail-fixture.js && node --check src/client/preview-fixture.js",
    "test": "node scripts/test-security.mjs && node scripts/test-rail-fixture.mjs && node scripts/test-package-smoke.mjs",
    "test:package": "node scripts/test-package-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  },
  "license": "MIT"
}
